# ============================================================
# DriveTrack — Ejemplo de configuración de entorno
# ============================================================
# Copia este archivo como .env y rellena con tus valores reales.
# ⚠️ NUNCA subas el archivo .env a Git.
# ============================================================

# Base de datos
# SQLite (desarrollo): sqlite+aiosqlite:///./drivetrack.db
# PostgreSQL (producción): postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./drivetrack.db

# Modo debug (True = activa /docs, logs SQL, más verbosidad)
# ⚠️ Siempre False en producción
DEBUG=True

# JWT Secret Key (OBLIGATORIA — sin esta variable la app no arranca)
# Genera una nueva con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERATE_A_REAL_SECRET_HERE_AT_LEAST_32_CHARS

# JWT Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — Lista de orígenes permitidos (JSON array)
# Flutter web local: http://localhost:8080
# Emulador Android: http://10.0.2.2:8000
# Producción: https://tuapp.com
ALLOWED_ORIGINS=["http://localhost:8080","http://localhost:3000"]

# OpenWeatherMap — API key para el proxy de clima
# Obtener en: https://openweathermap.org/api
OPENWEATHER_API_KEY=YOUR_OWM_KEY_HERE

# MinIO / S3 Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=YOUR_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=YOUR_MINIO_SECRET_KEY
MINIO_BUCKET=drivertrack
MINIO_SECURE=False
